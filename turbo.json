{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "COPILOT_URL",
        "BOARD_URL",
        "EXPLORER_URL",
        "KIOSK_URL",
        "GEMINI_MODEL",
        "DAILY_ANALYSIS_LIMIT"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "storybook-static/**"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
