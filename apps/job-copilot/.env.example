# Supabase → Project Settings → Database → Connection string (Transaction pooler)
DATABASE_URL=
# Supabase → Project Settings → API Keys (publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# aistudio.google.com/apikey (free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=
# Public origin that serves every app (the portfolio). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=
